type Quote {
  id: ID!
  text: String!
  author: String!
}

input NewQuoteInput {
  text: String!
  author: String!
}

input UpdateQuoteInput {
  text: String!
  author: String!
}

type Query {
  quotes: [Quote!]!
  quote(id: ID!): Quote
}

type Mutation {
  createQuote(input: NewQuoteInput!): Quote!
  updateQuote(id: ID!, input: UpdateQuoteInput!): Quote
  deleteQuote(id: ID!): Boolean!
}